+		PIN_SLP(gpk2-0, INPUT, DOWN);
+		PIN_SLP(gpk2-1, INPUT, DOWN);
+		PIN_SLP(gpk2-2, INPUT, DOWN); /* NC */
+		PIN_SLP(gpk2-3, INPUT, DOWN);
