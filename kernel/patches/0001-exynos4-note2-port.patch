--- /dev/null
+++ b/arch/arm/mach-exynos/note2-legacy-ramlog.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Temporary SHV-E250K boot diagnosis, compatible with Samsung sec_log.c.
+ * Layout confirmed against this phone's S-Boot arguments and live TWRP:
+ *   0x45fffff8: LOGM magic; 0x45fffffc: byte counter;
+ *   0x46000000..0x461fffff: 2 MiB power-of-two character ring.
+ * A matching, non-reusable DT reservation is mandatory. No flash access.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+
+#include <asm/barrier.h>
+#include <asm/cacheflush.h>
+#include <asm/outercache.h>
+
+#define NOTE2_LOG_BASE 0x46000000UL
+#define NOTE2_LOG_SIZE 0x00200000UL
+#define NOTE2_RESERVE_BASE 0x45fff000UL
+#define NOTE2_RESERVE_SIZE 0x00201000UL
+#define NOTE2_LOG_MAGIC 0x4d474f4cU
+
+static char *note2_log_buf;
+static u32 *note2_log_pos;
+static DEFINE_RAW_SPINLOCK(note2_log_lock);
+
+/* Normal direct-mapped RAM: clean both cache levels before publishing index. */
+static void note2_log_flush(void *address, size_t count)
+{
+	phys_addr_t physical = virt_to_phys(address);
+
+	dmac_flush_range(address, (char *)address + count);
+	outer_clean_range(physical, physical + count);
+	dsb(sy);
+}
+
+static void note2_log_write(struct console *con, const char *s,
+			    unsigned int count)
+{
+	unsigned long flags;
+	u32 pos;
+
+	/* A nested panic must not deadlock inside its diagnostic console. */
+	if (!raw_spin_trylock_irqsave(&note2_log_lock, flags))
+		return;
+	pos = READ_ONCE(*note2_log_pos);
+	while (count) {
+		u32 offset = pos & (NOTE2_LOG_SIZE - 1);
+		u32 length = min_t(u32, count, NOTE2_LOG_SIZE - offset);
+
+		memcpy(note2_log_buf + offset, s, length);
+		note2_log_flush(note2_log_buf + offset, length);
+		s += length;
+		pos += length;
+		count -= length;
+	}
+	WRITE_ONCE(*note2_log_pos, pos);
+	note2_log_flush(note2_log_pos, sizeof(*note2_log_pos));
+	raw_spin_unlock_irqrestore(&note2_log_lock, flags);
+}
+
+static struct console note2_log_console = {
+	.name = "n2log",
+	.write = note2_log_write,
+	.flags = CON_ENABLED | CON_PRINTBUFFER,
+	.index = 0,
+};
+
+static int __init note2_log_init(void)
+{
+	static const char marker[] = "\nNOTE2 MAINLINE RAMLOG v1 BEGIN\n";
+	struct device_node *node;
+	struct reserved_mem *reserved;
+	u32 *magic;
+	bool valid;
+
+	if (!of_machine_is_compatible("samsung,n7105") ||
+	    !strstr(boot_command_line, "androidboot.hardware=SHV-E250K") ||
+	    !strstr(boot_command_line, "sec_log=0x200000@0x46000000"))
+		return 0;
+	node = of_find_node_by_path("/reserved-memory/note2-bootlog@45fff000");
+	if (!node)
+		return 0;
+	reserved = of_reserved_mem_lookup(node);
+	valid = reserved && reserved->base == NOTE2_RESERVE_BASE &&
+		reserved->size == NOTE2_RESERVE_SIZE &&
+		!of_property_read_bool(node, "no-map") &&
+		!of_property_read_bool(node, "reusable");
+	of_node_put(node);
+	if (!valid)
+		return 0;
+
+	note2_log_buf = phys_to_virt(NOTE2_LOG_BASE);
+	note2_log_pos = phys_to_virt(NOTE2_LOG_BASE - sizeof(u32));
+	magic = phys_to_virt(NOTE2_LOG_BASE - 2 * sizeof(u32));
+	WRITE_ONCE(*note2_log_pos, 0);
+	WRITE_ONCE(*magic, NOTE2_LOG_MAGIC);
+	note2_log_flush(magic, 2 * sizeof(u32));
+	note2_log_write(&note2_log_console, marker, sizeof(marker) - 1);
+	register_console(&note2_log_console);
+	pr_info("note2-ramlog: legacy Samsung ring enabled before SMP/driver init\n");
+	return 0;
+}
+console_initcall(note2_log_init);
