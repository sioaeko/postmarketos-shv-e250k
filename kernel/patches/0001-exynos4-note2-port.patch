+		PIN_SLP(gpk1-2, INPUT, DOWN);
+		PIN_SLP(gpk1-3, PREV, NONE); /* NAND_D-4 */
+		PIN_SLP(gpk1-4, PREV, NONE); /* NAND_D-5 */
+		PIN_SLP(gpk1-5, PREV, NONE); /* NAND_D-6 */
+		PIN_SLP(gpk1-6, PREV, NONE); /* NAND_D-7 */
