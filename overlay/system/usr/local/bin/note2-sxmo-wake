#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# The Exynos DRM backend can reject the first enable commit after DPMS off.
# Retry only while Sxmo still intends to keep the display on.
for attempt in 1 2 3; do
    case "$(cat "${SXMO_STATE:-$XDG_RUNTIME_DIR/sxmo.state}" 2>/dev/null)" in
        unlock|lock|locker) ;;
        *) exit 0 ;;
    esac
    for connector in /sys/class/drm/card*-DSI-1; do
        if [ "$(cat "$connector/dpms" 2>/dev/null)" = On ] &&
           [ "$(cat "$connector/enabled" 2>/dev/null)" = enabled ]; then
            exit 0
        fi
    done
    swaymsg -q 'output DSI-1 power on'
    sleep 1
done
